// Agent-to-agent inbox: flow of one question and its answer.
// Render: dot -Tpng -Gdpi=160 agent-inbox-flow.dot -o agent-inbox-flow.png
digraph flow {
  rankdir=LR;
  newrank=true;
  compound=true;
  nodesep=0.35;
  ranksep=0.7;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#888888", fontname="Helvetica", fontsize=11, margin="0.15,0.08"];
  edge [fontname="Helvetica", fontsize=10, color="#2563eb", fontcolor="#1e3a8a", penwidth=1.4];

  label=<<b>Agent-to-agent inbox: one question, one answer</b><br/><font point-size="10">Blue: the question. Green: the answer. Orange: a person is asked. Grey dashed: Slack copy for people.</font>>;
  labelloc=t;
  fontsize=16;

  subgraph cluster_you {
    label=<<b>Your machine</b>>; style="rounded,filled"; fillcolor="#eff6ff"; color="#93c5fd";
    you_agent  [label="Your agent\n(Claude Code, Codex, any)\n\"Is PR 812 going to merge?\""];
    you_mcp    [label="MCP tool or CLI\nask(to: Miguel, kind: question,\nrepo, PR, files, session id)"];
    you_handler[label="Your local handler"];
    you_back   [label="Answer pushed into the\nsession that asked\n(or that session resumed via ACP)", fillcolor="#ecfdf5", color="#34d399"];
  }

  subgraph cluster_exchange {
    label=<<b>Exchange (cloud)</b>>; style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1";
    exchange [label="Workspaces, contacts,\ninboxes, threads\n(stores every message)", fillcolor="#f1f5f9"];
  }

  subgraph cluster_slack {
    label=<<b>Slack</b>>; style="rounded,filled"; fillcolor="#fafafa"; color="#d4d4d8";
    slack [label="One thread per conversation\nmuted; pings only when\na person is needed", fillcolor="#f4f4f5"];
  }

  subgraph cluster_them {
    label=<<b>Teammate's machine</b>>; style="rounded,filled"; fillcolor="#f5f3ff"; color="#c4b5fd";
    them_handler [label="Their local handler\n(default presets, or their\nown script on `inbox watch`)"];
    rules [label="Their rules decide\nmatch: sender, kind, repo,\nurgency, already busy on it?", shape=diamond, style="filled", fillcolor="#ede9fe", color="#8b5cf6", margin="0.05,0.05"];
    live  [label="Push into their live session\n(one is already on that PR)"];
    start [label="Start their agent via ACP\nin a separate worktree\n(counts against daily limit)"];
    hold  [label="Hold in inbox\n(seen at next session start)"];
    askme [label="Ask the person first\n(Approve / Decline / Reply)", fillcolor="#fff7ed", color="#fb923c"];
    them_agent [label="Their agent\nanswers facts from GitHub,\nlocal branch, notes.\nNever promises."];
    person [label="Teammate", shape=ellipse, fillcolor="#fff7ed", color="#fb923c"];
  }

  // Question
  you_agent -> you_mcp      [label=" 1  ask"];
  you_mcp   -> exchange     [label=" 2  send"];
  exchange  -> them_handler [label=" 3  deliver"];
  them_handler -> rules     [label=" 4"];
  rules -> live   [label=" busy on it"];
  rules -> start  [label=" allowed"];
  rules -> hold   [label=" laptop off / hold", color="#64748b", fontcolor="#334155"];
  rules -> askme  [label=" request", color="#ea580c", fontcolor="#9a3412"];
  live  -> them_agent;
  start -> them_agent;

  // Intent questions go to the person
  them_agent -> person [label=" 5b  intent?\n(\"will you merge it?\")", color="#ea580c", fontcolor="#9a3412"];
  askme -> person [color="#ea580c"];

  // Answer
  them_agent -> exchange [label=" 5  reply (facts)", color="#059669", fontcolor="#065f46"];
  person     -> exchange [label=" 6  reply (one tap\nin Slack)", color="#059669", fontcolor="#065f46"];
  exchange   -> you_handler [label=" 7  deliver answer", color="#059669", fontcolor="#065f46"];
  you_handler -> you_back   [label=" 8", color="#059669", fontcolor="#065f46"];
  you_back -> you_agent [label=" carries on\n with the merge", color="#059669", fontcolor="#065f46", style=dashed];

  // Slack copy
  exchange -> slack [style=dashed, color="#9ca3af", arrowhead=none, label=" copy", fontcolor="#6b7280"];
  slack -> person   [style=dashed, color="#9ca3af", label=" ping only\n if needed", fontcolor="#6b7280"];

  { rank=same; you_agent; }
  { rank=same; exchange; slack; }
}
